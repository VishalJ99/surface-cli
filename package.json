{
  "name": "surface-cli",
  "version": "0.5.0",
  "description": "A lean, local-first mail CLI for Gmail, Outlook, and generic IMAP with a JSON-first contract for automation.",
  "homepage": "https://github.com/VishalJ99/surface-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VishalJ99/surface-cli.git"
  },
  "bugs": {
    "url": "https://github.com/VishalJ99/surface-cli/issues"
  },
  "keywords": [
    "cli",
    "email",
    "gmail",
    "outlook",
    "automation",
    "mcp",
    "openclaw",
    "codex",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "surface": "dist/cli.js",
    "surface-mcp": "dist/mcp-server.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "docs/mcp.md",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp": "node dist/mcp-server.js",
    "surface": "tsx src/cli.ts",
    "test": "npm run build --silent && node dist/test-runner.js dist",
    "test:mcp": "npm run build --silent && node dist/test-runner.js dist/mcp",
    "prepack": "npm run build",
    "e2e:outlook-v1": "tsx src/e2e/outlook-v1.ts",
    "e2e:gmail-v1": "tsx src/e2e/gmail-v1.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "imapflow": "^1.3.5",
    "mailparser": "^3.9.9",
    "nodemailer": "^8.0.10",
    "playwright-core": "^1.55.0",
    "smol-toml": "^1.6.1",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
